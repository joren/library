= form_tag :books, method: :get, class: "form-inline mb-3"
  = search_field_tag :q, params[:q], placeholder: "Zoek op titel of auteur", class: "form-control mr-sm-2"
  .btn.btn-outline-secondary= label_tag do
    | verberg gelezen
    span.ml-1 = check_box_tag "search_options[hide_read]", true, params.dig(:search_options, :hide_read)
  = submit_tag "zoek", class: "btn btn-primary ml-2"
  = link_to "clear", :books, class: "btn btn-outline-secondary my-2 my-sm-0 ml-2"
