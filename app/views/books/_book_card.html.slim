.card.flex-md-row.mb-4.shadow-sm.h-md-250
  = link_to book do
    = image_tag(book.cover.variant(resize: "140x245"), alt: book.title, class: "card-img-left flex-auto d-none d-lg-block")
  .card-body.d-flex.flex-column.align-items-start.position-relative
    h5.card-title
      = link_to book.title, book, class: "text-dark"
    .card-text.font-weight-bold = book.author
    .card-text = sanitize(book.introduction.truncate_words(25))
    .card-text.fixed-bottom.position-relative
      small.text-muted.text-lighter
        | Geüpload door:
        =< link_to book.user.name, [:user, :books, user_id: book.user]
