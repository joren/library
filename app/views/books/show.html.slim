- read = current_user.read_books.exists?(@book.id)
.row.mt-3
  .col-4
  .col-8
    div
      span.h2.mr-2 = @book.title
      - if read
        span.badge.badge-success.badge-pill gelezen

.row
  .col-4.text-center
    - if @book.cover
      = image_tag @book.cover.variant(resize: "250x600"), alt: @book.title
    .mt-3
      = link_to "download", [:download, @book], class: "btn btn-primary", data: { confirm: "Let op, deel dit boek aub niet met andere mensen!"}, target: :_blank
      .mt-1
        - if @book.user == current_user
          = link_to "bewerk", [:edit, @book], class: "btn btn-secondary ml-2 btn-sm"
          = link_to "verwijder", @book, method: :delete, data: { confirm: "Ben je zeker dat je dit boek wil verwijderen?" }, class: "btn btn-secondary ml-2 btn-sm"
        = link_to "Markeer als #{read ? 'ongelezen' : 'gelezen'}", [:toggle_read, @book], method: :post, class: "btn btn-secondary btn-sm ml-2"
  .col-8
    = sanitize(@book.introduction)

    h4.mt-3 Info
    dl
      dt Auteur
      dd = @book.author
      - if @book.pages
        dt Pagina's
        dd = @book.pages
      - if @book.goodreads_url
        dt Goodreads link
        dd = link_to @book.goodreads_url, @book.goodreads_url, target: "_blank"

    h4 Gelezen door
    - if @book.read_by_users.any?
      = @book.read_by_users.map { |u| link_to(u.name, [:user, :books, user_id: u]) }.to_sentence.html_safe
    - else
      | Dit boek werd nog door niemand gelezen.
      =<> link_to "Download", [:download, @book],  data: { confirm: "Let op, deel dit boek aub niet met andere mensen!"}, target: :_blank
      | het boek en lees het boek als eerste.

    h4.mt-3 Laatste 10 acties
    dl
      - @book.user_actions.order(created_at: :desc).limit(10).each do |action|
        dd
          => t("actions.#{action.action.sub('_', '.')}")
          | door
          =<> link_to action.user.name, [:user, :books, user_id: action.user]
          | op
          =< action.created_at
