<p>
  <strong>Title:</strong>
  <%= @book.title %>
</p>

<p>
  <strong>Introduction:</strong>
  <%= @book.introduction %>
</p>

<% @book.images.each do |image| %>
  <%= image_tag(image) %>
<% end %>

<p>
  <strong>Book:</strong>
  <%= link_to "download", rails_blob_path(@book.book) %>
</p>

<%= link_to 'Edit', edit_book_path(@book) %> |
<%= link_to 'Back', books_path %>
