h2 All books

table.table.table-striped
  thead
    tr
      th scope="col" Title
      th Added at
      th Added by
      th &nbsp;
  tbody
    - @books.each do |book|
      tr
        td scope="row" = link_to book.title, book
        td = book.created_at
        td = book.user.name
        td = link_to "View", book, class: "btn btn-info btn-sm"
  tfoot
    tr
      td colspan=4 = paginate(@books)
